PORT=8080
CORS_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...anon...
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 保护定时任务（Railway Cron 请求头 x-cron-secret）
CRON_SECRET=change-me-to-a-long-random-string

# 飞书自建应用（P0 单向推送）
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
# 接收人：飞书注册手机号（用于查 open_id）
FEISHU_RECEIVER_MOBILE=199xxxxxxxx
# 接收人在本系统的 user_id（UUID，用于拉任务）
FEISHU_RECEIVER_USER_ID=00000000-0000-0000-0000-000000000000
